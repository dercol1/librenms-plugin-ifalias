{
    "name": "dercol1/librenms-plugin-ifalias",
    "description": "LibreNMS plugin adding lnms port:ifAlias, to tell apart the ifAlias values a user overrode from the ones LibreNMS filled in on its own",
    "keywords": [
        "librenms",
        "plugin",
        "ifalias",
        "port"
    ],
    "type": "package",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "diego",
            "email": "98904661+dercol1@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "librenms/plugin-interfaces": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-mockery": "^1.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Dercol1\\LibrenmsIfAlias\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dercol1\\LibrenmsIfAlias\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dercol1\\LibrenmsIfAlias\\IfAliasPluginProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --no-progress",
        "test:unit": "phpunit",
        "fix": [
            "@fix:lint"
        ],
        "fix:lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
